{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ehsan",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "517c1e74-3d34-4bdd-95d1-085b736c5bf7","database_name": "ehsan" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "9a16cc2d757c484e95e41c08b58d60e6" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
